---
// モバイルメニューは React を使わず、小さなスクリプトで開閉する（下部）。
// リンクは「/#…」形式なので、記事ページなどトップ以外からでも正しくトップへ移動できる。
const base = import.meta.env.BASE_URL;
const NAV = [
  { href: "#philosophy", label: "Philosophy" },
  { href: "#services", label: "Services" },
  { href: "#process", label: "How We Work" },
  { href: "#works", label: "Works" },
  { href: "#journal", label: "Journal" },
  { href: "#company", label: "Company" },
];
---

<header class="pt-safe border-b border-[var(--border)] bg-[var(--bg)]/95 backdrop-blur-sm">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-5 py-3 sm:px-8">
    <a
      href={`${base}#top`}
      class="text-lg font-bold tracking-[0.18em] text-[var(--deep)]"
      aria-label="はんなりdev トップへ"
    >
      はんなりdev
    </a>

    <nav aria-label="メインナビゲーション" class="hidden items-center gap-7 lg:flex">
      {
        NAV.map((item) => (
          <a
            href={`${base}${item.href}`}
            class="py-2 text-[13px] font-medium tracking-[0.14em] text-[var(--text)] transition-colors hover:text-[var(--accent)]"
          >
            {item.label}
          </a>
        ))
      }
      <a
        href={`${base}#contact`}
        class="bg-[var(--deep)] px-5 py-2 text-[13px] font-medium tracking-[0.14em] text-white transition-colors hover:bg-[var(--accent)]"
      >
        お問い合わせ
      </a>
    </nav>

    <button
      type="button"
      id="menu-toggle"
      class="flex min-h-11 min-w-11 items-center justify-center text-[var(--deep)] lg:hidden"
      aria-label="メニューを開く"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span id="menu-icon" class="text-2xl leading-none" aria-hidden="true">≡</span>
    </button>
  </div>

  <nav
    id="mobile-menu"
    aria-label="メインナビゲーション（モバイル）"
    class="hidden border-t border-[var(--border)] px-5 py-3 lg:hidden"
  >
    <ul class="flex flex-col">
      {
        NAV.map((item) => (
          <li>
            <a
              href={`${base}${item.href}`}
              class="block py-3 text-sm font-medium tracking-[0.14em] text-[var(--text)]"
            >
              {item.label}
            </a>
          </li>
        ))
      }
      <li>
        <a
          href={`${base}#contact`}
          class="mt-2 block bg-[var(--deep)] px-5 py-3 text-center text-sm font-medium tracking-[0.14em] text-white"
        >
          お問い合わせ
        </a>
      </li>
    </ul>
  </nav>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  const icon = document.getElementById("menu-icon");

  if (toggle && menu && icon) {
    const setOpen = (open: boolean) => {
      menu.classList.toggle("hidden", !open);
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "メニューを閉じる" : "メニューを開く");
      icon.textContent = open ? "×" : "≡";
    };
    toggle.addEventListener("click", () => setOpen(toggle.getAttribute("aria-expanded") !== "true"));
    // メニュー内のリンクを押したら閉じる
    menu.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => setOpen(false)));
  }
</script>
