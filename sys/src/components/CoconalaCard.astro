---
import { PROFILE } from "../profile";

const { url, rating, sales, proCertified, asOf } = PROFILE.coconala;
const show = url !== null;
---

{
  show && (
    <>
      <dl class="grid grid-cols-3 gap-4 border-y border-[var(--border)] py-5 text-center">
        <div>
          <dt class="text-xs tracking-[0.1em] text-[var(--dim)]">評価</dt>
          <dd class="mt-1 text-2xl font-medium text-[var(--deep)]">
            <span class="text-[var(--accent)]" aria-hidden="true">★</span>
            {rating?.toFixed(1)}
          </dd>
        </div>
        <div>
          <dt class="text-xs tracking-[0.1em] text-[var(--dim)]">販売実績</dt>
          <dd class="mt-1 text-2xl font-medium text-[var(--deep)]">
            {sales}<span class="ml-0.5 text-sm">件</span>
          </dd>
        </div>
        <div>
          <dt class="text-xs tracking-[0.1em] text-[var(--dim)]">認定</dt>
          <dd class="mt-1 text-base font-medium text-[var(--deep)]">{proCertified ? "プロ認定" : "—"}</dd>
        </div>
      </dl>

      {asOf && <p class="mt-3 text-xs text-[var(--dim)]">{asOf}</p>}

      <a
        href={url}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-6 inline-block border border-[var(--deep)] px-6 py-2.5 text-sm font-medium tracking-[0.14em] text-[var(--deep)] transition-colors hover:bg-[var(--deep)] hover:text-white"
      >
        ココナラのプロフィールを見る
      </a>
    </>
  )
}

