---
import Reveal from "./Reveal.astro";

interface Props {
  index: string;
  label: string;
  title: string;
}
const { index, label, title } = Astro.props;
---

<Reveal>
  <div class="flex items-baseline gap-4">
    <span class="text-sm font-medium tracking-[0.2em] text-[var(--accent)]">{index}</span>
    <p class="text-xs font-medium uppercase tracking-[0.35em] text-[var(--dim)]">{label}</p>
  </div>
  <h2 class="mt-4 text-2xl font-medium tracking-[0.12em] text-[var(--deep)] sm:text-3xl">
    {title}
  </h2>
  <div class="mt-6 h-px w-full bg-[var(--border)]"></div>
</Reveal>
