---
import Reveal from "./Reveal.astro";
import SectionHeading from "./SectionHeading.astro";

const ROWS = [
  { term: "会社名", value: "はんなりdev" },
  {
    term: "事業内容",
    value: "ソフトウェア・Web開発、ITコンサルティング",
  },
  {
    term: "お問い合わせ",
    value: "本ページのお問い合わせフォームよりご連絡ください",
  },
];
---

<section id="company" class="bg-[var(--surface)] py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <SectionHeading index="06" label="Company" title="会社について" />
    <Reveal>
      <dl class="mt-10 max-w-3xl">
        {
          ROWS.map((row) => (
            <div class="grid gap-1 border-b border-[var(--border)] py-5 sm:grid-cols-[180px_1fr] sm:gap-6">
              <dt class="text-sm font-medium tracking-[0.14em] text-[var(--dim)]">{row.term}</dt>
              <dd class="leading-relaxed text-[var(--text)]">{row.value}</dd>
            </div>
          ))
        }
      </dl>
      <p class="mt-6 max-w-3xl text-sm leading-loose text-[var(--dim)]">
        所在地・連絡先などの詳細は、お問い合わせいただいた際にご案内します。
      </p>
    </Reveal>
  </div>
</section>
