---
// 実績の帯（代表者について ページの上部）。値が未確定の項目は表示しない。
import Reveal from "./Reveal.astro";
import { PROFILE } from "../profile";

interface Props {
  class?: string;
}
const { class: className = "mt-16 sm:mt-20" } = Astro.props;
const { experienceYears, coconala, credentials } = PROFILE;

const items: string[] = [];
if (experienceYears) items.push(`IT 業界 ${experienceYears} 年以上`);
if (credentials.length > 0) items.push(`IPA 高度試験 ${credentials.length} 区分に合格`);
if (coconala.rating !== null && coconala.sales !== null) {
  items.push(`ココナラ 評価 ${coconala.rating.toFixed(1)}（販売実績 ${coconala.sales} 件）`);
}
if (coconala.proCertified) items.push("ココナラ プロ認定");
---

{
  items.length > 0 && (
    <section aria-label="実績" class={`mx-auto max-w-6xl px-5 sm:px-8 ${className}`}>
      <Reveal>
        <ul class="flex flex-wrap gap-x-8 gap-y-3 border-y border-[var(--border)] py-5 text-sm font-medium tracking-[0.08em] text-[var(--deep)]">
          {items.map((item) => (
            <li class="flex items-center gap-2">
              <span aria-hidden="true" class="h-1.5 w-1.5 rounded-full bg-[var(--accent)]" />
              {item}
            </li>
          ))}
        </ul>
      </Reveal>
    </section>
  )
}
