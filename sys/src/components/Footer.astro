---
const base = import.meta.env.BASE_URL;
const NAV = [
  { href: "#philosophy", label: "Philosophy" },
  { href: "#services", label: "Services" },
  { href: "#process", label: "How We Work" },
  { href: "#works", label: "Works" },
  { href: "#journal", label: "Journal" },
  { href: "#company", label: "Company" },
  { href: "#contact", label: "Contact" },
];
---

<footer class="bg-[var(--deep)] text-white">
  <div class="mx-auto max-w-6xl px-5 py-14 sm:px-8">
    <div class="flex flex-col gap-8 sm:flex-row sm:items-start sm:justify-between">
      <p class="text-lg font-bold tracking-[0.18em]">はんなりdev</p>
      <nav aria-label="フッターナビゲーション">
        <ul class="flex flex-wrap gap-x-6 gap-y-3 text-[13px] tracking-[0.12em]">
          {
            NAV.map((item) => (
              <li>
                <a class="py-1 hover:underline" href={`${base}${item.href}`}>
                  {item.label}
                </a>
              </li>
            ))
          }
          <li><a class="py-1 hover:underline" href={`${base}privacy/`}>Privacy</a></li>
        </ul>
      </nav>
    </div>
    <div class="mt-10 border-t border-white/25 pt-6">
      <p class="text-xs tracking-[0.14em] text-white/70">
        はんなりdev — ソフトウェア・Web開発／ITコンサルティング
      </p>
    </div>
  </div>
</footer>
