---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  /** OGP 画像（public/ 内のパス） */
  ogImage?: string;
  noindex?: boolean;
  type?: "website" | "article";
}

const SITE_NAME = "はんなりdev";
const DEFAULT_TITLE = "はんなりdev | 建物を設計するように、システムを設計する";
const DEFAULT_DESC =
  "はんなりdevは、ソフトウェア・Web開発とITコンサルティングの小さな会社です。建物を設計するように、システムを設計します。";

const {
  title = DEFAULT_TITLE,
  description = DEFAULT_DESC,
  ogImage = "/og.jpg",
  noindex = false,
  type = "website",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogUrl = new URL(ogImage, Astro.site);
---

<!doctype html>
<html lang="ja">
  <head>
    <!-- Google Tag Manager -->
    <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-KXK4SKRQ');</script>
    <!-- End Google Tag Manager -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F3F7F3" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <!-- 構造化データ（組織の情報）。個人名は判断事項 #1 の決定後に追加する -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      name: SITE_NAME,
      url: Astro.site ? Astro.site.toString() : undefined,
      description: DEFAULT_DESC,
    })}></script>

    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content={type} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- フォント: 確定した M PLUS Rounded 1c のみ読み込む -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=M+PLUS+Rounded+1c:wght@400;500;700&display=swap"
    />

    <!-- JS が有効なときだけスクロール演出を有効にする（無効でも本文は全て表示される） -->
    <script is:inline>document.documentElement.classList.add("js");</script>
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-KXK4SKRQ"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-3 focus:top-3 focus:z-50 focus:bg-[var(--deep)] focus:px-4 focus:py-2 focus:text-white"
      >本文へスキップ</a
    >
    <div class="min-h-screen bg-[var(--bg)] text-[var(--text)]">
      <div class="sticky top-0 z-40">
        <Header />
      </div>
      <main id="main">
        <slot />
      </main>
      <Footer />
    </div>

    <script>
      // スクロールで一度だけ表示（.reveal）
      const reveals = document.querySelectorAll<HTMLElement>(".reveal");
      if ("IntersectionObserver" in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.12 },
        );
        reveals.forEach((el) => io.observe(el));
      } else {
        reveals.forEach((el) => el.classList.add("is-visible"));
      }

      // 画像のゆるやかな視差（[data-parallax]）。動きを減らす設定のときは何もしない。
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const items = Array.from(document.querySelectorAll<HTMLElement>("[data-parallax]"));
      if (!reduce && items.length > 0) {
        let raf = 0;
        const update = () => {
          raf = 0;
          const vh = window.innerHeight || 1;
          for (const wrap of items) {
            const img = wrap.querySelector<HTMLElement>(".parallax-img");
            if (!img) continue;
            const rect = wrap.getBoundingClientRect();
            if (rect.bottom < -100 || rect.top > vh + 100) continue;
            const strength = Number(wrap.dataset.parallax) || 0;
            const progress = (rect.top + rect.height / 2 - vh / 2) / (vh / 2 + rect.height / 2);
            const clamped = Math.max(-1, Math.min(1, progress));
            img.style.transform = `translateY(${(clamped * strength).toFixed(1)}px) scale(1.14)`;
          }
        };
        const onScroll = () => {
          if (!raf) raf = requestAnimationFrame(update);
        };
        update();
        window.addEventListener("scroll", onScroll, { passive: true });
        window.addEventListener("resize", onScroll);
      }
    </script>
  </body>
</html>
